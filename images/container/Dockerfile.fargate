# runway runner image for ECS Fargate: one task per job, then the container exits.
# Fargate has no privileged mode, so there's no Docker daemon in this image.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

ARG RUNNER_VERSION
ARG RUNNER_SHA256_ARM64
ARG RUNNER_SHA256_X64

COPY install-runner.sh /tmp/install-runner.sh
RUN WITH_AWSCLI=1 bash /tmp/install-runner.sh && rm /tmp/install-runner.sh
COPY runway_agent.py /opt/runway/runway_agent.py

ENV HOME=/root \
    RUNWAY_RUNNER_DIR=/opt/actions-runner \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

ENTRYPOINT ["python3", "/opt/runway/runway_agent.py", "oneshot"]
