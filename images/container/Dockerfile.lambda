# runway runner image for Lambda functions: one invocation per job, 15 minutes at most,
# no Docker. The runner is copied to /tmp at start, since the rest of the filesystem is
# read-only and the runner writes next to its binaries.
FROM public.ecr.aws/lambda/python:3.14

ARG RUNNER_VERSION
ARG RUNNER_SHA256_ARM64
ARG RUNNER_SHA256_X64

COPY install-runner.sh /tmp/install-runner.sh
RUN bash /tmp/install-runner.sh && rm /tmp/install-runner.sh
COPY runway_agent.py ${LAMBDA_TASK_ROOT}/runway_agent.py

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

CMD ["runway_agent.lambda_handler"]
